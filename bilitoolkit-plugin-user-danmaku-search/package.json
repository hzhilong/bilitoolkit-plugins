{
  "name": "bilitoolkit-plugin-user-danmaku-search",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "index.html",
  "description": "根据 UID 查询用户公开的直播弹幕记录，并保存本地查询历史",
  "author": "struggle0929",
  "keywords": [
    "BiliToolkit",
    "哔哩工具姬",
    "bilitoolkit-plugin",
    "bilitoolkit-plugin:name:用户弹幕查询",
    "bilitoolkit-plugin:type:ui"
  ],
  "files": [
    "dist",
    "!dist/bundle-stats.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hzhilong/bilitoolkit-plugins",
    "directory": "bilitoolkit-plugin-user-danmaku-search"
  },
  "bugs": {
    "url": "https://github.com/hzhilong/bilitoolkit-plugins/issues"
  },
  "homepage": "https://github.com/hzhilong/bilitoolkit-plugins/tree/main/bilitoolkit-plugin-user-danmaku-search#readme",
  "scripts": {
    "删除缓存": "rimraf node_modules/.vite",
    "check": "vue-tsc --build --noEmit && eslint .",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "dev": "rimraf node_modules/.vite && chcp 65001 && vite",
    "dev(cache)": "chcp 65001 && vite",
    "build": "vite build",
    "npm login": "npm login",
    "pnpm publish": "pnpm publish --access public"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
